# Database Configuration (PostgreSQL - see docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5435/booktour_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=16379

# JWT Secret
JWT_SECRET=your_jwt_secret_key_that_is_at_least_256_bits_long_for_hmac_sha256
# Access token 15 phut, refresh token 30 ngay (mili giay)
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
# Cookie chua refresh token. Production (frontend va backend khac domain):
# REFRESH_COOKIE_SECURE=true va REFRESH_COOKIE_SAME_SITE=None, bat buoc HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
# URL PayOS redirect ve sau khi thanh toan xong/huy. Production: doi sang domain that.
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Frontend URL (dung cho CORS va link trong email). Production: doi sang domain that.
FRONTEND_URL=http://localhost:5173

# Brevo (email service, thay the Spring Mail/SMTP)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Tai khoan admin duoc tao san khi khoi dong lan dau (DataInitializerConfig)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@example.com

# Optional: danh sach proxy tin cay (vi du CloudFront/ELB) de doc dung IP that cua client cho rate limiting
TRUSTED_PROXIES=

# Da thay the boi Brevo API o tren, khong con duoc code su dung - giu lai chi de tham khao
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
